# ==============================================================================
# PackSci AI - Environment Variables Template
# AI-Based Intelligent Food Packaging Material Recommendation System
# ==============================================================================

# PostgreSQL Database (Supabase or Local PostgreSQL)
DATABASE_URL=postgresql://postgres.example:password@aws-0-region.pooler.supabase.com:6543/postgres

# Groq API Configuration for Fast AI LLM Grounding
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL_NAME=qwen/qwen3.8-27b

# Qdrant Vector Cloud for Semantic Search & Domain Knowledge RAG
QDRANT_URL=https://your-cluster-id.region.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=packaging_knowledge_base

# Security & JWT Token Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Configuration
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
DEBUG=True
