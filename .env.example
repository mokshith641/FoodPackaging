# ==============================================================================
# PackSci AI — Production Environment Variables Template
# AI-Based Intelligent Food Packaging Material Recommendation System
# ==============================================================================

# --- DATABASE CONFIGURATION (Supabase PostgreSQL) ---
# Connection pooling string from Supabase project settings
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# --- GROQ API CONFIGURATION (LLM Inference) ---
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL_NAME=qwen/qwen3.8-27b

# --- QDRANT CLOUD CONFIGURATION (Vector Database / RAG) ---
QDRANT_URL=https://[YOUR-CLUSTER-ID].[REGION].cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=food_packaging_corpus
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- AUTHENTICATION & JWT SECURITY ---
JWT_SECRET_KEY=generate_a_random_32_character_hex_or_base64_string_for_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- CORS & PLATFORM NETWORKING ---
# Set to your production Vercel frontend URL on Render (e.g. https://packsci-ai.vercel.app)
FRONTEND_URL=https://your-app-name.vercel.app
CORS_ORIGINS=https://your-app-name.vercel.app,http://localhost:5173

# --- RUNTIME SETTINGS ---
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- FRONTEND CLIENT VARIABLE (Vercel) ---
# Only VITE_ prefixed variables are exposed to the browser bundle
VITE_API_BASE_URL=https://your-backend-name.onrender.com
