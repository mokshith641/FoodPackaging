# Database Configuration
# Use Supabase PostgreSQL connection string or local PostgreSQL / SQLite
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# Or fallback to SQLite for local development:
# DATABASE_URL=sqlite:///./food_packaging.db

# Groq API Configuration for AI Explanation Service
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Frontend CORS Origin
FRONTEND_ORIGIN=http://localhost:5173

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
